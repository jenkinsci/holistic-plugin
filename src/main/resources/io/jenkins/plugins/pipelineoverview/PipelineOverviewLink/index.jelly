<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

    <l:layout type="full-screen" title="${it.view.dashboardTitle}">
        <l:main-panel>
            <link rel="stylesheet"
                  href="${rootURL}/plugin/holistic/css/overview-dashboard.css"
                  type="text/css" />

            <div id="overview-dashboard"
                 data-view-url="${rootURL}/pipeline-overview/"
                 data-refresh-interval="${it.view.refreshIntervalSeconds}"
                 data-dashboard-title="${it.view.dashboardTitle}"
                 data-fullscreen="true">
                <div class="od-loading">
                    <l:spinner text="Loading dashboard data" />
                </div>
            </div>

            <script type="text/javascript"
                    src="${rootURL}/plugin/holistic/js/overview-dashboard.js">
            </script>
        </l:main-panel>
    </l:layout>

</j:jelly>
